PORT=4000
# Google Sheets service account (Google Cloud Console -> Service Account -> JSON key)
# Share each building's Google Sheet with this service account email (Editor access).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Set true to auto-sync connected sheets after every data change
SHEETS_AUTOSYNC=false

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
SESSION_ABSOLUTE_TTL_MIN=240
SESSION_INACTIVITY_TIMEOUT_MIN=30
# Only used once, to create the one Master Admin account if none exists yet.
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=
# Origin the browser client is served from (used for CORS + CSRF Origin check).
CLIENT_ORIGIN=http://localhost:5173
